# URL base do backend de sincronização (opcional).
# Sem essa variável o app funciona 100% local (IndexedDB) e a fila de sync fica pendente.
# Contrato da API em docs/backend/API.md
NEXT_PUBLIC_SYNC_ENDPOINT=

# Identificação enviada ao Nominatim (OpenStreetMap exige um contato identificável).
NEXT_PUBLIC_APP_CONTACT=contato@exemplo.com
