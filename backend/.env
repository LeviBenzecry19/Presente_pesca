# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=3f9a1c7d5e2b48a6903c17fe64d8b25a
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB/MySQL local na porta 3306. Sobrescreva usuário/senha em .env.local
# (arquivo não versionado) se o seu servidor não usar root sem senha.
DATABASE_URL="mysql://root:@127.0.0.1:3306/pesca?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# O PWA roda em http://localhost:3000 e o backend em http://localhost:8000,
# então toda chamada do navegador é cross-origin.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> app ###
# Fotos das capturas ficam fora de public/: são servidas por um controller.
PESCA_PHOTO_DIR='%kernel.project_dir%/var/storage/photos'
# Limite por foto. O cliente já comprime para ~200–400 KB antes de enviar.
PESCA_MAX_PHOTO_BYTES=8388608
###< app ###
